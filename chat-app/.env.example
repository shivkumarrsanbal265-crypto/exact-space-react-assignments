# ========================================================
# EXACTSPACE CHAT APP ENVIRONMENT CONFIGURATION
# ========================================================

# Backend Server Port (default: 5000)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Allowed Frontend Origin(s) for CORS in production
# Single domain: https://your-chat-frontend.vercel.app
# Multiple domains (comma-separated): https://frontend.domain.com,https://staging.domain.com
# Development default: http://localhost:5173,http://localhost:4173
CLIENT_URL=http://localhost:5173

# Frontend Socket.IO Connection URL (Vite)
# Point this to your hosted backend URL when deploying frontend separately.
# Example: https://your-chat-backend.onrender.com
# If hosting frontend and backend together on the same domain, leave empty.
VITE_SOCKET_URL=http://localhost:5000

